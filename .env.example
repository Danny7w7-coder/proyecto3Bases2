# Configuración de SIG-TEC (plantilla)
#
# NO hace falta copiar este archivo a mano: la primera vez que se corre cualquier script
# (por ejemplo python scripts/init_all.py) se crea .env a partir de esta plantilla y
# las claves vacías se llenan con valores ALEATORIOS. El archivo .env no se sube a git.

# Sistema de referencia institucional (CRTM05). Si se cambia, hay que correr init_all.py --reset
SRID=5367

# Versión de la imagen de PostgreSQL + PostGIS
POSTGIS_IMAGE=postgis/postgis:17-3.5

# Base de datos y superusuario (iguales en los 6 nodos)
DB_NAME=sigtec
DB_USER=postgres
DB_PASSWORD=

# Usuario que usan las suscripciones para leer de los publicadores
REPL_USER=replicador
REPL_PASSWORD=

# Rol de edición de cada campus (sigtec_<campus>). El plugin recibe esta clave
# del central SOLO después de un ingreso correcto.
EDITOR_PASSWORD=

# Rol del plugin en el central. Es PÚBLICO a propósito: solo puede ejecutar autenticar()
# (no puede leer ninguna tabla). Por eso su clave es fija y va también en
# plugin/sigtec/config.ini, así el plugin funciona en cualquier instalación.
LOGIN_USER=sigtec_login
LOGIN_PASSWORD=sigtec_login

# Dirección con la que QGIS (fuera de Docker) llega a los nodos
HOST_PUBLICO=localhost

# Puertos en la máquina anfitriona (se evita el 5432 por si ya hay un PostgreSQL instalado)
PORT_CENTRAL=5440
PORT_CARTAGO=5441
PORT_SAN_JOSE=5442
PORT_SAN_CARLOS=5443
PORT_ALAJUELA=5444
PORT_LIMON=5445
